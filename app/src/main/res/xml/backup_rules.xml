<?xml version="1.0" encoding="utf-8"?>
<!--
  Peyo is offline-first and its database holds financial history, so none of it is copied off the
  device by Android's automatic backup. The account's own backup is what brings history back.

  The rest goes with it, because each part only means something beside the database:
  - peyo.account holds the signed-in session and its refresh token, which is a credential.
  - peyo.sync holds how far the last sync got. Restored onto an empty database it told the next
    sync that everything had already been pulled, so a new phone quietly showed almost nothing.
  - attachments/ holds receipt screenshots, which the privacy policy says stay on this phone, and
    which no row would point at once restored without the database.
  Appearance, currency and backup preferences in peyo.settings are harmless and still restore.
-->
<full-backup-content>
    <exclude domain="database" path="peyo.db" />
    <exclude domain="database" path="peyo.db-shm" />
    <exclude domain="database" path="peyo.db-wal" />
    <exclude domain="sharedpref" path="peyo.account.xml" />
    <exclude domain="sharedpref" path="peyo.sync.xml" />
    <exclude domain="file" path="attachments/" />
</full-backup-content>
