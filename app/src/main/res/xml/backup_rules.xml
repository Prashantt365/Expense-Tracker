<?xml version="1.0" encoding="utf-8"?>
<!--
  Peyo is offline-first and its database holds financial history, so nothing is copied off
  the device by Android's automatic backup.
-->
<full-backup-content>
    <exclude domain="database" path="peyo.db" />
    <exclude domain="database" path="peyo.db-shm" />
    <exclude domain="database" path="peyo.db-wal" />
</full-backup-content>
