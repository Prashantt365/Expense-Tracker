<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml, which explains each exclusion. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="peyo.account.xml" />
        <exclude domain="sharedpref" path="peyo.sync.xml" />
        <exclude domain="file" path="attachments/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="peyo.account.xml" />
        <exclude domain="sharedpref" path="peyo.sync.xml" />
        <exclude domain="file" path="attachments/" />
    </device-transfer>
</data-extraction-rules>
