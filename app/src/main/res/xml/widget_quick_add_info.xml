<?xml version="1.0" encoding="utf-8"?>
<!-- One button. Small by default, and allowed to be made smaller still. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="50dp"
    android:minHeight="50dp"
    android:minResizeWidth="50dp"
    android:minResizeHeight="50dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="250dp"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_quick_add_description"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_quick_add_preview"
    android:initialLayout="@layout/widget_loading" />
