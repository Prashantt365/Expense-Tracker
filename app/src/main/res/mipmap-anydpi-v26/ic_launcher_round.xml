<?xml version="1.0" encoding="utf-8"?>
<!--
  The Peyo wordmark in brand green on the off-white card. The wordmark is 56dp wide on the 108dp
  canvas, which keeps all of it inside the 66dp circle a launcher is guaranteed to show whatever
  mask shape it applies.

  The themed layer is the same wordmark flattened to one colour; with no separate symbol in the
  mark, the wordmark is the part that has to read.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
