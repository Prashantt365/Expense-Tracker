<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Read only, requested at runtime from the people settings and only when the user asks to
      import. Names are read into the people list; nothing is written back and nothing leaves
      the device.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Signing in and backing up transactions. The app works fully offline without it: everything
      is written to the local database first and syncing is what happens afterwards, so a refused
      or absent connection costs the backup, never the data.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Peyo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Makes Peyo appear when a Google Pay receipt screenshot is shared. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Accepts a statement shared or opened from a file manager or mail client. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Launcher shortcuts, each of which can also be pinned to the home screen. -->
            <intent-filter>
                <action android:name="com.peyo.app.ADD_EXPENSE" />
                <action android:name="com.peyo.app.SPLIT_EXPENSE" />
                <action android:name="com.peyo.app.IMPORT_PDF" />
                <action android:name="com.peyo.app.OPEN_BALANCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Home screen widgets. Both are Glance widgets, so the receiver is the framework's entry
          point and the composable behind it does the drawing.

          exported is true because the launcher is a different process and has to be able to bind
          them; that is what a widget is. Neither accepts anything from the broadcast other than
          the framework's own update and delete actions, and neither reads an extra.
        -->
        <!--
          Redraws the widgets after an app update, which otherwise leaves them on the placeholder
          layout until the app is next opened. Not exported: the only sender is the system, and
          only about this app.
        -->
        <receiver
            android:name=".widget.WidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.SummaryWidgetReceiver"
            android:label="@string/widget_summary_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_summary_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:label="@string/widget_quick_add_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>
    </application>
</manifest>
